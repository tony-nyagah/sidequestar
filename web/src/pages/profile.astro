---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ProfileForm from "../components/ProfileForm.astro";
import ScaleBar from "../components/ScaleBar.astro";
import Duration from "../components/Duration.astro";
import { Icon } from "astro-icon/components";
import { listQuests, getProfile } from "../lib/api";
import type { Profile, Quest } from "../lib/api";

let profile: Profile | null = null;
let completed: Quest[] = [];
let apiDown = false;

try {
  [profile, completed] = await Promise.all([getProfile(Astro.locals), listQuests(Astro.locals, "completed")]);
} catch {
  apiDown = true;
}

const error = Astro.url.searchParams.get("error");
const notice = Astro.url.searchParams.get("notice");
const heading = "flex items-center gap-2 border-b-[1.5px] border-base-content pb-2 font-display text-2xl font-bold";
const segments = 10;
const filled = profile
  ? Math.min(segments, Math.floor((profile.xp_into_level / profile.xp_needed) * segments))
  : 0;
const dateFmt = new Intl.DateTimeFormat("en", { day: "numeric", month: "short", year: "numeric" });
---

<Layout title="Your profile · Sidequestar">
  <Header profile={profile} />

  <main class="mx-auto max-w-6xl px-5 py-8 sm:py-10">
    <a href="/" class="inline-flex items-center gap-1.5 font-medium underline">
      <Icon name="ph:arrow-left-bold" class="size-4" aria-hidden="true" />
      Back to quests
    </a>
    <h1 class="mt-4 font-display text-4xl font-bold tracking-tight sm:text-5xl">Your profile</h1>

    {
      apiDown && (
        <div role="alert" class="alert mt-6 rounded-box border-[1.5px] border-base-content bg-warning text-warning-content">
          <Icon name="ph:warning-circle-bold" class="size-6" aria-hidden="true" />
          <span>
            Can't reach the API. Start it with <code class="font-mono text-sm font-semibold">make dev</code>, then reload.
          </span>
        </div>
      )
    }

    {
      error && (
        <div role="alert" class="alert mt-6 rounded-box border-[1.5px] border-base-content bg-error text-error-content">
          <Icon name="ph:x-circle-bold" class="size-6" aria-hidden="true" />
          <span>{error}</span>
        </div>
      )
    }

    {
      notice && (
        <div role="status" class="alert mt-6 rounded-box border-[1.5px] border-base-content bg-success text-success-content">
          <Icon name="ph:check-circle-bold" class="size-6" aria-hidden="true" />
          <span>{notice}</span>
        </div>
      )
    }

    {
      profile && (
        <div class="mt-8 grid gap-12 lg:grid-cols-12 lg:items-start">
          <section aria-labelledby="knows-title" class="space-y-6 lg:col-span-7">
            <h2 id="knows-title" class={heading}>
              <Icon name="ph:sparkle-bold" class="size-6 text-primary" aria-hidden="true" />
              What the quest-giver knows
            </h2>
            <p class="max-w-[65ch] text-base-content/80">
              Every time you summon a quest, these lines go to{" "}
              {profile.model ? <strong class="font-semibold">{profile.model}</strong> : "the local model"},
              together with what you typed into Summon a quest. Nothing else about you is sent, and none
              of it leaves this computer.
            </p>

            <figure class="contour-field rounded-box border-[1.5px] border-base-content p-5">
              <figcaption class="mb-3 font-medium">Sent with every quest</figcaption>
              {profile.known_facts.length > 0 ? (
                <ul class="space-y-2 rounded-field border-[1.5px] border-base-content bg-base-100 p-4 leading-relaxed">
                  {profile.known_facts.map((fact) => (
                    <li>{fact}</li>
                  ))}
                </ul>
              ) : (
                <p class="rounded-field border-[1.5px] border-base-content bg-base-100 p-4 text-base-content/80">
                  Nothing yet. Right now the quest-giver only knows what you type each time.
                </p>
              )}
            </figure>

            <section
              aria-labelledby="summary-title"
              class="rounded-box border-[1.5px] border-base-content bg-base-100 p-5 sm:p-6"
            >
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b-[1.5px] border-base-content pb-2">
                <h3 id="summary-title" class="flex items-center gap-2 font-display text-2xl font-bold">
                  <Icon name="ph:notebook-bold" class="size-6 text-primary" aria-hidden="true" />
                  What it has worked out
                </h3>
                {profile.summary_updated_at && (
                  <p class="text-sm text-base-content/70">
                    Updated <time datetime={profile.summary_updated_at}>{dateFmt.format(new Date(profile.summary_updated_at))}</time>
                  </p>
                )}
              </div>
              <p class="mt-3 max-w-[65ch] text-base-content/80">
                The quest-giver rewrites this after every quest you finish, from your own words and the
                quests you finish. Fix anything it got wrong; it keeps your corrections.
              </p>

              {!profile.summary && (
                <div class="mt-3 max-w-[65ch] text-base-content/80">
                  No summary yet. Until there is one, it goes by your most common quest tags
                  {profile.interests.length > 0 && (
                    <ul class="mt-2 flex flex-wrap gap-1.5" aria-label="Interests">
                      {profile.interests.map((tag) => (
                        <li class="badge rounded-field border-[1.5px] border-base-content bg-base-200 italic">{tag}</li>
                      ))}
                    </ul>
                  )}
                </div>
              )}

              <form method="post" action="/api/profile" class="mt-4 grid gap-3">
                <label class="block">
                  <span class="sr-only">Summary</span>
                  <textarea
                    name="summary"
                    rows="4"
                    maxlength={1200}
                    placeholder="Finish a quest, or press Rewrite now, and the quest-giver will write this."
                    class="textarea w-full resize-y border-base-content text-base placeholder:text-base-content/60"
                  >{profile.summary}</textarea>
                </label>
                <div class="flex flex-wrap gap-2">
                  <button type="submit" class="btn btn-neutral btn-outline">
                    <Icon name="ph:check-bold" class="size-5" aria-hidden="true" />
                    Save my edits
                  </button>
                  <button
                    type="submit"
                    formaction="/api/profile/summary"
                    class="group btn btn-primary"
                    disabled={!profile.model}
                  >
                    <span class="contents group-aria-busy:hidden">
                      <Icon name="ph:arrows-clockwise-bold" class="size-5" aria-hidden="true" />
                      Rewrite now
                    </span>
                    <span class="hidden items-center gap-2 group-aria-busy:inline-flex">
                      <span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
                      Rewriting…
                    </span>
                  </button>
                </div>
              </form>
            </section>

            <ProfileForm profile={profile} />

            <section id="account" aria-labelledby="account-title" class="rounded-box border-[1.5px] border-base-content bg-base-100 p-5 sm:p-6">
              <div class="mb-4 flex items-center gap-2 border-b-[1.5px] border-base-content pb-2">
                <Icon name="ph:key-bold" class="size-6 text-accent" aria-hidden="true" />
                <h2 id="account-title" class="font-display text-2xl font-bold">Account</h2>
              </div>

              <form method="post" action="/api/account/password" class="grid gap-3">
                <h3 class="font-display text-lg font-semibold">Change password</h3>
                <label class="block">
                  <span class="mb-1.5 block font-medium">Current password</span>
                  <input type="password" name="current_password" required autocomplete="current-password" class="input w-full border-base-content" />
                </label>
                <div class="grid gap-3 sm:grid-cols-2">
                  <label class="block">
                    <span class="mb-1.5 block font-medium">New password</span>
                    <input type="password" name="new_password" required minlength={8} maxlength={72} autocomplete="new-password" class="input w-full border-base-content" />
                  </label>
                  <label class="block">
                    <span class="mb-1.5 block font-medium">New password again</span>
                    <input type="password" name="confirm_password" required minlength={8} maxlength={72} autocomplete="new-password" class="input w-full border-base-content" />
                  </label>
                </div>
                <button type="submit" class="btn btn-neutral btn-outline sm:w-auto sm:justify-self-start">
                  <Icon name="ph:check-bold" class="size-5" aria-hidden="true" />
                  Change password
                </button>
              </form>

              <form method="post" action="/api/account/delete" class="mt-6 grid gap-3 border-t-[1.5px] border-base-300 pt-5">
                <h3 class="font-display text-lg font-semibold">Delete account</h3>
                <p class="max-w-[65ch] text-base-content/80">
                  This deletes your account, your quests and photos, your XP, and everything the quest-giver
                  has learned about you. It can't be undone.
                </p>
                <label class="block">
                  <span class="mb-1.5 block font-medium">Your password, to confirm</span>
                  <input type="password" name="password" required autocomplete="current-password" class="input w-full border-base-content sm:max-w-sm" />
                </label>
                <button type="submit" class="btn btn-error btn-outline sm:w-auto sm:justify-self-start">
                  <Icon name="ph:trash-bold" class="size-5" aria-hidden="true" />
                  Delete my account
                </button>
              </form>
            </section>
          </section>

          <section aria-labelledby="xp-title" class="order-first lg:order-none lg:col-span-5">
            <h2 id="xp-title" class={heading}>
              <Icon name="ph:medal-bold" class="size-6 text-secondary" aria-hidden="true" />
              Your XP
            </h2>

            <dl class="mt-6 grid grid-cols-2 gap-4">
              <div class="rounded-box border-[1.5px] border-base-content bg-base-100 p-4">
                <dt class="text-sm font-medium text-base-content/70">Total XP</dt>
                <dd class="font-display text-5xl font-bold leading-none tabular-nums">{profile.xp_total}</dd>
              </div>
              <div class="rounded-box border-[1.5px] border-base-content bg-base-100 p-4">
                <dt class="text-sm font-medium text-base-content/70">Quests completed</dt>
                <dd class="font-display text-5xl font-bold leading-none tabular-nums">{profile.completed_count}</dd>
              </div>
              <div class="col-span-2 rounded-box border-[1.5px] border-base-content bg-base-100 p-4">
                <dt class="text-sm font-medium text-base-content/70">Level {profile.level}</dt>
                <dd>
                  <p class="font-display text-2xl font-semibold">{profile.title}</p>
                  <div class="mt-3">
                    <ScaleBar
                      filled={filled}
                      total={segments}
                      size="lg"
                      label={`${profile.xp_into_level} of ${profile.xp_needed} XP to the next level`}
                    />
                    <div class="mt-1 flex justify-between text-sm font-medium text-base-content/70">
                      <span>{profile.xp_into_level} / {profile.xp_needed} XP</span>
                      <span>{profile.xp_needed - profile.xp_into_level} XP to level {profile.level + 1}</span>
                    </div>
                  </div>
                </dd>
              </div>
            </dl>

            <h3 class="mt-10 font-display text-xl font-bold">Where your XP came from</h3>
            {completed.length > 0 ? (
              <ol class="mt-3 divide-y-[1.5px] divide-base-300 border-y-[1.5px] border-base-content">
                {completed.map((q) => (
                  <li class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-1 py-3">
                    <p class="font-semibold">{q.title}</p>
                    <p class="row-span-2 self-center font-display text-xl font-bold text-primary tabular-nums">
                      +{q.xp_awarded ?? 0}
                    </p>
                    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-base-content/70">
                      {q.completed_at && <time datetime={q.completed_at}>{dateFmt.format(new Date(q.completed_at))}</time>}
                      <Duration bucket={q.duration_bucket} />
                      {q.photo_path && (
                        <span class="inline-flex items-center gap-1">
                          <Icon name="ph:camera-bold" class="size-4 text-accent" aria-hidden="true" />
                          Photo bonus
                        </span>
                      )}
                    </p>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="mt-3 text-base-content/75">
                No XP yet. Finish a quest on <a href="/" class="underline">your route</a> to earn some.
              </p>
            )}
          </section>
        </div>
      )
    }
  </main>
</Layout>

<script>
  // Rewriting waits on the local model; show it's working and block a double submit.
  document.querySelectorAll<HTMLButtonElement>('button[formaction="/api/profile/summary"]').forEach((button) => {
    button.form?.addEventListener("submit", (event) => {
      if (event.submitter !== button) return;
      button.setAttribute("aria-busy", "true");
      queueMicrotask(() => (button.disabled = true));
    });
  });
</script>

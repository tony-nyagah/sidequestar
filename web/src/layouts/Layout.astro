---
import "../styles/global.css";
import "@fontsource-variable/fraunces";
import "@fontsource-variable/outfit";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Sidequestar gives you one small real-world quest to get you outside, powered by a local open-weight model."
    />
    <meta name="theme-color" content="#2f7a4f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-base-100 text-base-content antialiased">
    <slot />
  </body>
</html>

---
import { Icon } from "astro-icon/components";
import { durationLabel } from "../lib/api";
import type { Quest } from "../lib/api";

interface Props {
  quest: Quest;
}

const { quest } = Astro.props;
---

<article class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-display text-lg font-bold leading-snug">{quest.title}</h3>
    <span class="badge badge-neutral shrink-0">
      <Icon name="ph:clock" class="size-3.5" aria-hidden="true" />
      {durationLabel(quest.duration_bucket)}
    </span>
  </div>

  <p class="mt-2 text-base-content/75">{quest.description}</p>

  {
    quest.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {quest.tags.map((tag) => (
          <span class="badge badge-outline">{tag}</span>
        ))}
      </div>
    )
  }

  <div class="mt-4">
    <slot />
  </div>
</article>

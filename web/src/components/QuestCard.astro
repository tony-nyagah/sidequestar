---
import { Icon } from "astro-icon/components";
import Duration from "./Duration.astro";
import Tags from "./Tags.astro";
import type { Quest } from "../lib/api";

interface Props {
  quest: Quest;
}

const { quest } = Astro.props;
---

<article class="pin-drop relative rounded-box border-[1.5px] border-base-content bg-base-100 p-5 pl-14">
  <Icon
    name="ph:map-pin-fill"
    class="pin absolute left-4 top-4 size-7 text-secondary drop-shadow-[0_2px_1px_rgb(0_0_0/0.25)]"
    aria-hidden="true"
  />
  <h3 class="font-display text-xl font-bold leading-snug sm:text-2xl">{quest.title}</h3>
  <p class="mt-1.5 max-w-[65ch] text-base-content/80">{quest.description}</p>
  <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
    <Duration bucket={quest.duration_bucket} />
    <Tags tags={quest.tags} />
  </div>
  <div class="mt-4">
    <slot />
  </div>
</article>

---
import { Icon } from "astro-icon/components";
import ScaleBar from "./ScaleBar.astro";
import type { Profile } from "../lib/api";

interface Props {
  profile: Profile | null;
}

const { profile } = Astro.props;

const segments = 10;
const filled = profile
  ? Math.min(segments, Math.max(0, Math.floor((profile.xp_into_level / profile.xp_needed) * segments)))
  : 0;
---

<header class="border-b-[1.5px] border-base-content bg-secondary text-secondary-content">
  <div class="mx-auto grid max-w-6xl gap-6 px-5 py-6 sm:py-8 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <a href="/" class="inline-flex items-center gap-2.5">
        <Icon name="ph:compass-bold" class="size-8 sm:size-10" aria-hidden="true" />
        <span class="font-display text-4xl font-bold leading-none tracking-tight sm:text-6xl">Sidequestar</span>
      </a>
      <p class="mt-3 font-display text-xl font-semibold leading-tight sm:text-2xl">Go do something real.</p>
      <p class="mt-1 max-w-md text-secondary-content/80">
        One small thing to do away from work and school, and XP for actually doing it.
      </p>
    </div>

    {
      profile && (
        <section
          aria-label="Your level"
          class="grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-2 rounded-box border-[1.5px] border-base-content bg-base-100 p-4 text-base-content md:w-80"
        >
          <p class="row-span-2 font-display text-6xl font-bold leading-none tabular-nums sm:text-7xl">
            <span class="sr-only">Level </span>{profile.level}
          </p>
          <p class="self-end font-display text-2xl font-semibold leading-tight">{profile.title}</p>
          <p class="self-start text-sm text-base-content/70">
            {profile.completed_count} {profile.completed_count === 1 ? "quest" : "quests"} · {profile.xp_total} XP
          </p>
          <div class="col-span-2 mt-1">
            <ScaleBar
              filled={filled}
              total={segments}
              size="lg"
              label={`${profile.xp_into_level} of ${profile.xp_needed} XP to the next level`}
            />
            <div class="mt-1 flex justify-between text-xs font-medium text-base-content/70">
              <span>{profile.xp_into_level} / {profile.xp_needed} XP</span>
              <span>Level {profile.level + 1}</span>
            </div>
          </div>
        </section>
      )
    }
  </div>
</header>

---
import { Icon } from "astro-icon/components";
import type { Profile } from "../lib/api";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;

const progress = Math.min(
  100,
  Math.max(0, Math.round((profile.xp_into_level / profile.xp_needed) * 100)),
);
---

<header class="sticky top-0 z-10 border-b border-base-300 bg-base-100/80 backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-4">
    <a href="/" class="flex items-center gap-2.5">
      <span class="grid size-9 place-items-center rounded-box bg-primary text-primary-content shadow-sm">
        <Icon name="ph:tree-evergreen" class="size-5" aria-hidden="true" />
      </span>
      <span class="font-display text-xl font-bold tracking-tight">Sidequestar</span>
    </a>

    <div class="flex items-center gap-3">
      <div class="text-right">
        <p class="text-sm font-semibold leading-tight">{profile.title}</p>
        <p class="text-xs leading-tight text-base-content/60">
          Level {profile.level} · {profile.xp_total} XP
        </p>
      </div>
      <div class="grid size-11 place-items-center rounded-full bg-base-200 ring-1 ring-base-300">
        <span class="font-display text-sm font-bold">{profile.level}</span>
      </div>
    </div>
  </div>
  <div class="mx-auto max-w-3xl px-5 pb-3">
    <div class="h-1.5 w-full overflow-hidden rounded-full bg-base-200">
      <div class="h-full rounded-full bg-primary transition-all" style={`width: ${progress}%`} />
    </div>
  </div>
</header>

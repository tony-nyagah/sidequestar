---
import { Icon } from "astro-icon/components";
import { DURATION_BUCKETS } from "../lib/api";
---

<section class="rounded-box border-[1.5px] border-base-content bg-base-100 p-5 sm:p-6">
  <div class="mb-4 flex items-center gap-2 border-b-[1.5px] border-base-content pb-2">
    <Icon name="ph:plus-circle-bold" class="size-6 text-accent" aria-hidden="true" />
    <h2 class="font-display text-2xl font-bold">Add your own quest</h2>
  </div>

  <form method="post" action="/api/quests" class="grid gap-3 sm:grid-cols-2">
    <label class="block sm:col-span-2">
      <span class="mb-1.5 block font-medium">Title</span>
      <input type="text" name="title" required placeholder="Learn three chords on guitar"
        class="input w-full border-base-content placeholder:text-base-content/60" />
    </label>

    <label class="block sm:col-span-2">
      <span class="mb-1.5 block font-medium">Description</span>
      <textarea name="description" rows="2" required placeholder="A few words about what to actually do."
        class="textarea w-full border-base-content placeholder:text-base-content/60 resize-none"></textarea>
    </label>

    <label class="block">
      <span class="mb-1.5 block font-medium">How long will it take?</span>
      <select name="duration_bucket" class="select w-full border-base-content">
        {DURATION_BUCKETS.map((b) => (
          <option value={b.value}>{b.label}</option>
        ))}
      </select>
    </label>

    <label class="block">
      <span class="mb-1.5 block font-medium">Tags (comma separated)</span>
      <input type="text" name="tags" placeholder="music, creative" class="input w-full border-base-content placeholder:text-base-content/60" />
    </label>

    <button type="submit" class="btn btn-neutral btn-outline sm:col-span-2 sm:w-auto sm:justify-self-start">
      <Icon name="ph:plus-bold" class="size-5" aria-hidden="true" />
      Add quest
    </button>
  </form>
</section>

---
import { Icon } from "astro-icon/components";
import { DURATION_BUCKETS } from "../lib/api";
---

<section class="rounded-box border border-base-300 bg-base-100 p-6 shadow-sm">
  <div class="mb-4 flex items-center gap-2">
    <Icon name="ph:plus-circle" class="size-5 text-accent" aria-hidden="true" />
    <h2 class="font-display text-lg font-bold">Add your own quest</h2>
  </div>

  <form method="post" action="/api/quests" class="grid gap-3 sm:grid-cols-2">
    <label class="block sm:col-span-2">
      <span class="mb-1.5 block text-sm font-medium text-base-content/80">Title</span>
      <input type="text" name="title" required placeholder="Learn three chords on guitar"
        class="input input-bordered w-full" />
    </label>

    <label class="block sm:col-span-2">
      <span class="mb-1.5 block text-sm font-medium text-base-content/80">Description</span>
      <textarea name="description" rows="2" required placeholder="A few words about what to actually do."
        class="textarea textarea-bordered w-full resize-none"></textarea>
    </label>

    <label class="block">
      <span class="mb-1.5 block text-sm font-medium text-base-content/80">How long will it take?</span>
      <select name="duration_bucket" class="select select-bordered w-full">
        {DURATION_BUCKETS.map((b) => (
          <option value={b.value}>{b.label}</option>
        ))}
      </select>
    </label>

    <label class="block">
      <span class="mb-1.5 block text-sm font-medium text-base-content/80">Tags (comma separated)</span>
      <input type="text" name="tags" placeholder="music, creative" class="input input-bordered w-full" />
    </label>

    <button type="submit" class="btn btn-outline sm:col-span-2 sm:w-auto sm:justify-self-start">
      <Icon name="ph:plus" class="size-5" aria-hidden="true" />
      Add quest
    </button>
  </form>
</section>

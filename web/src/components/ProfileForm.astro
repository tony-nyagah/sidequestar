---
import { Icon } from "astro-icon/components";
import type { Profile } from "../lib/api";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<section class="rounded-box border-[1.5px] border-base-content bg-base-100 p-5 sm:p-6">
  <div class="mb-4 flex items-center gap-2 border-b-[1.5px] border-base-content pb-2">
    <Icon name="ph:user-circle-bold" class="size-6 text-info" aria-hidden="true" />
    <h2 class="font-display text-2xl font-bold">About you</h2>
  </div>

  {
    profile.interests.length > 0 && (
      <div class="mb-4 flex flex-wrap gap-1.5">
        {profile.interests.map((tag) => (
          <span class="badge rounded-field border-[1.5px] border-base-content bg-base-200 italic">{tag}</span>
        ))}
      </div>
    )
  }

  <form method="post" action="/api/profile" class="grid gap-3">
    <label class="block">
      <span class="mb-1.5 block font-medium">
        Where are you? <span class="font-normal text-base-content/70">(optional)</span>
      </span>
      <input type="text" name="location" value={profile.location} placeholder="Nairobi"
        class="input w-full border-base-content placeholder:text-base-content/60" />
    </label>

    <label class="block">
      <span class="mb-1.5 block font-medium">
        Anything the quest-giver should know? <span class="font-normal text-base-content/70">(optional)</span>
      </span>
      <textarea name="note" rows="2" placeholder="I'm recovering from a cold, keep it easy."
        class="textarea w-full border-base-content placeholder:text-base-content/60 resize-none">{profile.note}</textarea>
    </label>

    <button type="submit" class="btn btn-neutral btn-outline sm:w-auto sm:justify-self-start">
      <Icon name="ph:check-bold" class="size-5" aria-hidden="true" />
      Save
    </button>
  </form>
</section>

---
import Duration from "./Duration.astro";
import Tags from "./Tags.astro";
import type { Quest } from "../lib/api";

interface Props {
  quest: Quest;
  n: number;
  last: boolean;
}

const { quest, n, last } = Astro.props;
---

<li class="relative grid grid-cols-[2.25rem_1fr] gap-x-4">
  <div class="relative flex justify-center">
    {!last && <span class="footpath absolute top-10 bottom-0 w-0.5" aria-hidden="true" />}
    <span
      class="relative z-[1] grid size-9 place-items-center rounded-full border-[1.5px] border-base-content bg-primary font-display text-lg font-bold text-primary-content"
      aria-hidden="true"
    >
      {n}
    </span>
  </div>
  <div class="pb-8">
    <h3 class="font-display text-xl font-bold leading-snug">{quest.title}</h3>
    <p class="mt-1 max-w-[65ch] text-base-content/80">{quest.description}</p>
    <div class="mt-2.5 flex flex-wrap items-center gap-x-5 gap-y-2">
      <Duration bucket={quest.duration_bucket} />
      <Tags tags={quest.tags} />
    </div>
    <div class="mt-3">
      <slot />
    </div>
  </div>
</li>
